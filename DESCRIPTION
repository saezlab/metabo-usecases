Package: metabo.figures
Title: OmniPath Metabo Manuscript Figures and Tables Pipeline
Version: 0.0.0.9000
Authors@R: c(
    person("Dénes", "Türei", email = "turei.denes@gmail.com", role = c("aut", "cre")),
    person("Boglárka", "Várkonyi-Sepp", role = "aut"),
